<div class="quick-form">
  <label for="<%= field %>">
    <i class="fa-solid <%= icon %>"></i>
    <%= label %>
    <small><%= hint %></small>
  </label>
  <div class="input-action">
    <input
      id="<%= field %>"
      data-field="<%= field %>"
      type="number"
      min="0"
      step="1"
      inputmode="numeric"
      placeholder="0"
    />
    <button class="add-button" data-add="<%= field %>">Add</button>
  </div>
</div>
