<!doctype html>
<html lang="en">
  <head>
    <%- include('partials/head', { title: 'Overlay' }) %>
  </head>
  <body class="overlay-page">
    <section class="overlay-panel">
      <div class="overlay-stats">
        <div class="overlay-stat">
          <span class="overlay-label" title="Raids">
            <img class="game-icon raids-icon" src="/images/raids.svg" alt="Raids" />
          </span>
          <strong class="raid-value">
            <span data-stat="raids">0</span>
            <small>
              (<b class="win" data-stat="extracted">0</b>/<b class="loss" data-stat="failed">0</b>)
            </small>
          </strong>
        </div>

        <div class="overlay-stat">
          <span class="overlay-label" title="Kills">
            <img class="game-icon kills-icon" src="/images/kills.svg" alt="Kills" />
          </span>
          <strong data-stat="kills">0</strong>
        </div>

        <div class="overlay-stat">
          <span class="overlay-label" title="Gold items">
            <img class="game-icon" src="/images/gold.webp" alt="Gold items" />
          </span>
          <strong data-stat="gold">0</strong>
        </div>

        <div class="overlay-stat">
          <span class="overlay-label" title="Red items">
            <img class="game-icon" src="/images/red.webp" alt="Red items" />
          </span>
          <strong data-stat="red">0</strong>
        </div>

        <div class="overlay-stat value-stat">
          <span class="overlay-label" title="Extracted value">
            <img class="game-icon koen-icon" src="/images/koen.webp" alt="Extracted value" />
          </span>
          <strong>₭ <span data-stat="extractedValue">0</span></strong>
        </div>
      </div>
    </section>

    <script src="/js/overlay.js"></script>
  </body>
</html>
